# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These are public client identifiers, not secrets. Never commit .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase AI Logic backend: "google_ai" (Gemini Developer API, default) or "agent_platform"
NEXT_PUBLIC_AI_BACKEND=google_ai
NEXT_PUBLIC_AI_LOCATION=global
# Cloud model used for fallback and detailed analysis
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_GEMINI_DETAILED_MODEL=

# App Check. Production: reCAPTCHA Enterprise site key (or set PROVIDER=v3 for reCAPTCHA v3).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_PROVIDER=enterprise
# Local development: set to true, then register the debug token printed in the browser console
# in Firebase console → App Check → Apps → Manage debug tokens. Never commit a real token.
NEXT_PUBLIC_APPCHECK_DEBUG=false
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
