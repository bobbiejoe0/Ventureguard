rules_version = '2';

// Each user owns exactly one business document, keyed by their uid.
// Only the owner can read or write it and its subcollections.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(businessId) { return signedIn() && request.auth.uid == businessId; }

    function validBusiness() {
      let d = request.resource.data;
      // Merge writes (policies only) are allowed before onboarding completes.
      return !('name' in d) || (
        d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
        d.ownerId == request.auth.uid &&
        d.monthlyRevenue is number && d.monthlyRevenue >= 0 &&
        d.monthlyVariableCosts is number && d.monthlyVariableCosts >= 0 &&
        d.monthlyFixedCosts is number && d.monthlyFixedCosts >= 0 &&
        d.cashBalance is number &&
        d.outstandingDebt is number && d.outstandingDebt >= 0 &&
        d.monthlyDebtRepayment is number && d.monthlyDebtRepayment >= 0 &&
        d.currency is string && d.currency.size() == 3
      );
    }

    match /businesses/{businessId} {
      allow read: if isOwner(businessId);
      allow create, update: if isOwner(businessId) && validBusiness();
      allow delete: if isOwner(businessId);

      match /{collection}/{docId} {
        allow read, delete: if isOwner(businessId);
        allow create, update: if isOwner(businessId)
          && collection in ['simulations', 'insights', 'transactions', 'snapshots', 'risks', 'decisions']
          && request.resource.size() < 100000;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
